{
  "name": "hiyori-reader",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Word 文档朗读器：Live2D Hiyori 用 CosyVoice 朗读，嘴型由 airi 的 model-driver-lipsync（wLipSync）驱动",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "node scripts/fetch-assets.mjs",
    "predev": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-assets.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.1.0",
    "@pixi/app": "^6.5.10",
    "@pixi/constants": "^6.5.10",
    "@pixi/core": "^6.5.10",
    "@pixi/display": "^6.5.10",
    "@pixi/extensions": "^6.5.10",
    "@pixi/interaction": "^6.5.10",
    "@pixi/loaders": "^6.5.10",
    "@pixi/math": "^6.5.10",
    "@pixi/runner": "^6.5.10",
    "@pixi/settings": "^6.5.10",
    "@pixi/sprite": "^6.5.10",
    "@pixi/ticker": "^6.5.10",
    "@pixi/utils": "^6.5.10",
    "mammoth": "^1.13.0",
    "pixi-live2d-display": "^0.4.0",
    "vue": "^3.5.41",
    "wlipsync": "^1.3.1"
  },
  "devDependencies": {
    "@proj-airi/unplugin-live2d-sdk": "^0.1.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.11"
  }
}
